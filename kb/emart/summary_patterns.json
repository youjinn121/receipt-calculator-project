{
  "version": "1.0.0",
  "description": "Emart summary, subtotal, total, and tail-section patterns",
  "line_roles_supported": [
    "subtotal",
    "total"
  ],
  "classification_priority": [
    "total",
    "subtotal"
  ],
  "subtotal_patterns": {
    "description": "중간 합계 또는 품목 수 관련 라인",
    "match_mode": "regex_or_contains",
    "patterns": [
      {
        "name": "total_item_count",
        "role": "subtotal",
        "pattern": "^총\\s*품목\\s*수량\\s*(?P<count>\\d+)$",
        "flags": [],
        "extract_fields": [
          "count_raw"
        ],
        "description": "총 품목 수량 라인"
      },
      {
        "name": "item_count_without_space",
        "role": "subtotal",
        "pattern": "^총품목수량\\s*(?P<count>\\d+)$",
        "flags": [],
        "extract_fields": [
          "count_raw"
        ],
        "description": "공백 없는 총품목수량 라인"
      }
    ],
    "examples": [
      "총 품목 수량 15",
      "총품목수량 15"
    ],
    "notes": [
      "이마트 subtotal은 금액보다 품목 수량 정보가 나오는 경우가 많다",
      "subtotal은 item line이 아니며 파싱 종료 직전 보조 정보로 사용 가능하다"
    ]
  },
  "total_patterns": {
    "description": "최종 결제 금액 라인",
    "match_mode": "regex_or_contains",
    "patterns": [
      {
        "name": "payment_target_amount",
        "role": "total",
        "pattern": "^(?P<label>결제대상금액|제대상금액)\\s*(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "결제대상금액 및 OCR 오인식 제대상금액"
      },
      {
        "name": "sum_with_optional_space",
        "role": "total",
        "pattern": "^합\\s*계\\s*(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "합계 / 합 계 라인"
      }
    ],
    "examples": [
      "결제대상금액 15,370",
      "제대상금액 17,640",
      "합 계 15,370"
    ],
    "notes": [
      "최종 검증 기준 금액은 결제대상금액을 우선 사용",
      "합계 라인은 보조 total 후보로 유지 가능"
    ]
  },
  "tail_section_keywords": {
    "description": "이 키워드가 등장하면 item parsing 종료 구간으로 판단 가능",
    "keywords": [
      {
        "value": "결제대상금액",
        "type": "total"
      },
      {
        "value": "제대상금액",
        "type": "total"
      },
      {
        "value": "합계",
        "type": "total"
      },
      {
        "value": "합 계",
        "type": "total"
      },
      {
        "value": "부가세",
        "type": "tail_summary"
      },
      {
        "value": "부 가 세",
        "type": "tail_summary"
      },
      {
        "value": "면세물품",
        "type": "tail_summary"
      },
      {
        "value": "면세 물품",
        "type": "tail_summary"
      },
      {
        "value": "과세물품",
        "type": "tail_summary"
      },
      {
        "value": "과세 물품",
        "type": "tail_summary"
      },
      {
        "value": "총품목수량",
        "type": "subtotal"
      },
      {
        "value": "총 품목 수량",
        "type": "subtotal"
      }
    ],
    "notes": [
      "tail section 키워드는 line_type 직접 결정 외에도 종료 구간 판정에 사용 가능",
      "면세/과세/부가세 라인은 item parsing 대상이 아니라 tail summary 참고용이다"
    ]
  },
  "tax_summary_patterns": {
    "description": "세금/면세/과세 관련 보조 패턴",
    "match_mode": "regex_or_contains",
    "patterns": [
      {
        "name": "tax_free_goods_amount",
        "pattern": "^\\(*\\**\\)?\\s*면세\\s*물품\\s*(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "면세 물품 금액 라인"
      },
      {
        "name": "taxable_goods_amount",
        "pattern": "^과세\\s*물품\\s*(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "과세 물품 금액 라인"
      },
      {
        "name": "vat_amount",
        "pattern": "^부\\s*가\\s*세\\s*(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "부가세 금액 라인"
      }
    ],
    "examples": [
      "(*)면세 물품 1,450",
      "(*) 면세 물품 4,960",
      "과세 물품 12,655",
      "부 가 세 1,265",
      "부가세 면세 물품가액 24,890"
    ],
    "notes": [
      "이 라인들은 일반 item 파싱 대상이 아니다",
      "최종 common line_type에 tax 전용 타입이 없으므로 roles_map/policy에 따라 noise 또는 보조 필드로 유지 가능",
      "validation 또는 tail-section 판정에 참고용으로 사용 가능"
    ]
  },
  "field_mapping": {
    "subtotal": {
      "count_raw": "count",
      "price_raw": "value"
    },
    "total": {
      "price_raw": "value"
    },
    "tax_summary": {
      "price_raw": "value"
    }
  },
  "classification_rules": [
    {
      "name": "payment_target_amount_wins",
      "if": "line matches 결제대상금액 or 제대상금액 pattern",
      "assign_role": "total",
      "description": "최종 결제 금액 우선"
    },
    {
      "name": "sum_line_as_total",
      "if": "line matches 합계/합 계 and does not match transactional patterns",
      "assign_role": "total",
      "description": "합계 라인을 total로 처리"
    },
    {
      "name": "item_count_line_as_subtotal",
      "if": "line matches 총품목수량 pattern",
      "assign_role": "subtotal",
      "description": "품목 수량 라인을 subtotal로 처리"
    }
  ],
  "fallback_rules": [
    {
      "condition": "line contains 결제대상금액 or 제대상금액 and does not match item_detail or discount patterns",
      "assign_role": "total"
    },
    {
      "condition": "line contains 합계 and does not match item_detail or discount patterns",
      "assign_role": "total"
    },
    {
      "condition": "line contains 총품목수량 or 총 품목 수량",
      "assign_role": "subtotal"
    }
  ],
  "parser_notes": [
    "total must be checked before generic noise classification",
    "결제대상금액 should be treated as the primary receipt total when present",
    "합계 is a valid total candidate but may be secondary to 결제대상금액",
    "면세/과세/부가세 라인은 item parsing 종료 구간 판단에 사용할 수 있다"
  ],
  "semantic_handoff_notes": [
    "subtotal and total lines are preserved for receipt-level reconciliation",
    "tax_summary lines may be preserved as auxiliary information for validation",
    "parser extracts numeric candidates only and does not perform receipt-level validation"
  ]
}