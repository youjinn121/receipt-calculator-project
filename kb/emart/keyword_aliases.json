{
  "version": "1.0.0",
  "description": "Emart keyword aliases and OCR-variant mappings for normalization and keyword matching",
  "policy": {
    "purpose": [
      "OCR 오인식, 띄어쓰기 변형, 태그 포함 변형을 정규 키워드로 매핑한다",
      "이 파일은 keyword matching 보조용이며 최종 line classification은 pattern files에서 수행한다",
      "원본 line_text는 반드시 보존하고 normalized_line_text 또는 keyword matching 단계에서만 alias를 적용한다"
    ],
    "do_not_use_for": [
      "discount attachment",
      "item grouping",
      "semantic interpretation",
      "numeric field extraction"
    ]
  },
  "aliases": [
    {
      "canonical": "상품명",
      "type": "header_keyword",
      "match_mode": "exact_or_contains",
      "aliases": [
        "상품명"
      ],
      "description": "이마트 헤더 키워드"
    },
    {
      "canonical": "상품코드",
      "type": "header_keyword",
      "match_mode": "exact_or_contains",
      "aliases": [
        "상품코드"
      ],
      "description": "이마트 헤더 키워드"
    },
    {
      "canonical": "단가",
      "type": "header_keyword",
      "match_mode": "exact_or_contains",
      "aliases": [
        "단가"
      ],
      "description": "이마트 헤더 키워드"
    },
    {
      "canonical": "수량",
      "type": "header_keyword",
      "match_mode": "exact_or_contains",
      "aliases": [
