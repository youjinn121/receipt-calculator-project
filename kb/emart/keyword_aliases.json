  "normalization_helpers": {
    "space_insensitive_keywords": [
      "결제대상금액",
      "합계",
      "부가세",
      "면세물품",
      "과세물품",
      "총품목수량",
      "공병"
    ],
    "preserve_raw_tags": [
      "[앱]"
    ],
    "header_groups": [
      [
        "상품명",
        "단가",
        "수량",
        "금액"
      ],
      [
        "상품코드",
        "단가",
        "수량",
        "금액"
      ]
    ]
  },
  "recommended_matching_order": [
    "normalize whitespace",
    "apply alias matching",
    "apply store-specific item/discount/summary/noise patterns",
    "map store role to common line_type"
  ],
  "parser_notes": [
    "Alias matching must not overwrite original line_text.",
    "[앱] tag must remain visible in raw text for semantic and UI traceability.",
    "This file is for keyword equivalence and OCR variant matching only.",
    "Barcode parsing, amount extraction, and qty imputation must be handled in pattern files and policies."
  ]
}