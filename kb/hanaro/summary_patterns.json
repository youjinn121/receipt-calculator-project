{
  "version": "1.0.0",
  "description": "Hanaro summary, subtotal, total, and tail-section patterns",
  "line_roles_supported": [
    "subtotal",
    "total"
  ],
  "classification_priority": [
    "total",
    "subtotal"
  ],
  "subtotal_patterns": {
    "description": "중간 구매 금액 또는 요약 라인",
    "match_mode": "regex_or_contains",
    "patterns": [
      {
        "name": "gross_purchase_amount",
        "role": "subtotal",
        "pattern": "^총\\s*구매액\\s*[:：]?\\s*(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "총구매액 라인"
      }
    ],
    "examples": [
      "총구매액: 30,400",
      "총 구매액: 30,400"
    ],
    "notes": [
      "총구매액은 최종 결제 금액이 아니라 중간 요약값으로 사용",
      "subtotal은 item line이 아니며 파싱 종료 구간 판단에 활용 가능"
    ]
  },
  "total_patterns": {
    "description": "최종 결제 금액 라인",
    "match_mode": "regex_or_contains",
    "patterns": [
      {
        "name": "net_payment_amount",
        "role": "total",
        "pattern": "^내\\s*실\\s*금\\s*액\\s*[:：]?\\s*(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "내실금액 라인"
      }
    ],
    "examples": [
      "내실금액: 30,400",
      "내 실 금 액: 30,400"
    ],
    "notes": [
      "하나로의 최종 결제 금액은 내실금액을 우선 사용",
      "validation의 기준 total 값으로 활용 가능"
    ]
  },
  "tail_section_keywords": {
    "description": "이 키워드가 등장하면 item parsing 종료 구간으로 판단 가능",
    "keywords": [
      {
        "value": "총구매액",
        "type": "subtotal"
      },
      {
        "value": "총 구매액",
        "type": "subtotal"
      },
      {
        "value": "내실금액",
        "type": "total"
      },
      {
        "value": "내 실 금 액",
        "type": "total"
      },
      {
        "value": "총할인액",
        "type": "tail_summary"
      },
      {
        "value": "총 할인액",
        "type": "tail_summary"
      },
      {
        "value": "끝전할인",
        "type": "tail_summary"
      },
      {
        "value": "끝 전할 인",
        "type": "tail_summary"
      },
      {
        "value": "쿠폰할인",
        "type": "tail_summary"
      },
      {
        "value": "이벤트할인",
        "type": "tail_summary"
      },
      {
        "value": "할인쿠폰",
        "type": "tail_summary"
      }
    ],
    "notes": [
      "tail section 키워드는 line_type 직접 결정 외에도 종료 구간 판정에 사용 가능",
      "총할인액, 끝전할인, 쿠폰할인 등은 item parsing 대상이 아니라 하단 집계/할인 영역 판단에 사용 가능"
    ]
  },
  "discount_summary_patterns": {
    "description": "하단 할인 집계/보조 요약 패턴",
    "match_mode": "regex_or_contains",
    "patterns": [
      {
        "name": "total_discount_amount",
        "pattern": "^총\\s*할인액\\s*[:：]?\\s*(?P<value>-?[\\d,.]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "총할인액 라인"
      },
      {
        "name": "rounding_discount",
        "pattern": "^끝\\s*전\\s*할\\s*인\\s*[:：]?\\s*(?P<value>-?[\\d,.]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "끝전할인 라인"
      },
      {
        "name": "coupon_discount",
        "pattern": "^쿠폰할인\\s*[:：]?\\s*(?P<value>-?[\\d,.]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "쿠폰할인 라인"
      },
      {
        "name": "event_discount",
        "pattern": "^이벤트\\s*할인\\s*[:：]?\\s*(?P<value>-?[\\d,.]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "이벤트 할인 집계 라인"
      }
    ],
    "examples": [
      "총할인액: -4",
      "끝전할인: -4",
      "끝 전할 인: -1",
      "쿠폰할인: -660",
      "이벤트 할인: -1,400"
    ],
    "notes": [
      "이 라인들은 total은 아니며 하단 할인 집계/검증 참고값이다",
      "roles_map/policies에 따라 receipt_discount로 분류되거나 validation 보조값으로 사용할 수 있다",
      "parser는 수치 후보만 추출하고 중복 할인 제거는 수행하지 않는다"
    ]
  },
  "field_mapping": {
    "subtotal": {
      "price_raw": "value"
    },
    "total": {
      "price_raw": "value"
    },
    "discount_summary": {
      "price_raw": "value"
    }
  },
  "classification_rules": [
    {
      "name": "net_payment_amount_wins",
      "if": "line matches 내실금액 pattern",
      "assign_role": "total",
      "description": "최종 결제 금액 우선"
    },
    {
      "name": "gross_purchase_amount_as_subtotal",
      "if": "line matches 총구매액 pattern",
      "assign_role": "subtotal",
      "description": "중간 구매 금액 요약"
    }
  ],
  "fallback_rules": [
    {
      "condition": "line contains 내실금액 and does not match item_detail or discount_detail patterns",
      "assign_role": "total"
    },
    {
      "condition": "line contains 총구매액 and does not match item_detail patterns",
      "assign_role": "subtotal"
    }
  ],
  "parser_notes": [
    "total must be checked before generic noise classification",
    "내실금액 should be treated as the primary receipt total when present",
    "총구매액 is a subtotal-like summary value, not the final payment amount",
    "총할인액, 끝전할인, 쿠폰할인 등은 item parsing 종료 구간 판단과 validation 참고에 사용할 수 있다"
  ],
  "semantic_handoff_notes": [
    "subtotal and total lines are preserved for receipt-level reconciliation",
    "discount summary lines may be preserved as auxiliary information for validation",
    "parser extracts numeric candidates only and does not perform receipt-level validation or dedupe"
  ]
}