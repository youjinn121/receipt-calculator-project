{
  "version": "1.0.0",
  "description": "Hanaro item name and item detail parsing patterns",
  "line_roles_supported": [
    "item_name",
    "item_detail"
  ],
  "classification_priority": [
    "item_detail",
    "item_name"
  ],
  "item_name_patterns": {
    "description": "상품명 라인 판별 규칙",
    "match_mode": "regex_or_fallback_text",
    "patterns": [
      {
        "name": "numbered_item_name",
        "role": "item_name",
        "pattern": "^(?P<item_no>\\d{3})\\s+(?P<name>.+)$",
        "flags": [],
        "extract_fields": [
          "item_no",
          "name"
        ],
        "description": "3자리 번호 prefix 상품명"
      },
      {
        "name": "numbered_item_name_with_embedded_bracket_info",
        "role": "item_name",
        "pattern": "^(?P<item_no>\\d{3})\\s+(?P<name>.+?)(\\s+\\[[^\\]]+\\])?$",
        "flags": [],
        "extract_fields": [
          "item_no",
          "name"
        ],
        "description": "대괄호 보조 정보가 붙은 상품명"
      },
      {
        "name": "name_with_square_bracket_tag_prefix",
        "role": "item_name",
        "pattern": "^\\[(?P<tag>[^\\]]+)\\](?P<name>.+)$",
        "flags": [],
        "extract_fields": [
          "tag",
          "name"
        ],
        "description": "대괄호 태그가 선행하는 상품명"
      },
      {
        "name": "english_prefix_name",
        "role": "item_name",
        "pattern": "^(?P<prefix>[A-Za-z]{2,5})\\s+(?P<name>.+)$",
        "flags": [],
        "extract_fields": [
          "prefix",
          "name"
        ],
        "description": "COB 같은 영문 prefix 포함 상품명"
      }
    ],
    "examples": [
      "001 P삼겹살",
      "007 P뒷다리(일반) /냉동 [3,800]",
      "006 [카드쿠폰(율)]선진 삼겹",
      "COB P커피땅콩 헤이즐넛향 300.0g"
    ],
    "notes": [
      "상품번호 3자리는 prefix로 보고 제거 가능",
      "대괄호 내부는 보조 가격/태그 정보로 normalization 대상",
      "COB 같은 영문 prefix는 상품명 일부가 아닌 경우 제거 가능",
      "item_detail이나 discount_detail에 매칭되지 않는 텍스트 중심 라인은 item_name fallback 후보가 될 수 있다"
    ]
  },
  "item_detail_patterns": {
    "description": "상품 상세 라인 패턴",
    "match_mode": "regex",
    "patterns": [
      {
        "name": "star_code_unit_qty_total",
        "role": "item_detail",
        "pattern": "^\\*\\s*(?P<code>\\d{6,13})\\s+(?P<unit_price>[\\d,.]+)\\s+(?P<qty>\\d+)\\s+(?P<total_price>[\\d,.]+)$",
        "flags": [],
        "extract_fields": [
          "code",
          "unit_price",
          "qty",
          "total_price"
        ],
        "description": "* + code + unit_price + qty + total_price"
      },
      {
        "name": "plain_code_unit_qty_total",
        "role": "item_detail",
        "pattern": "^(?P<code>\\d{6,13})\\s+(?P<unit_price>[\\d,.]+)\\s+(?P<qty>\\d+)\\s+(?P<total_price>[\\d,.]+)$",
        "flags": [],
        "extract_fields": [
          "code",
          "unit_price",
          "qty",
          "total_price"
        ],
        "description": "code + unit_price + qty + total_price"
      },
      {
        "name": "numbered_star_code_unit_qty_total",
        "role": "item_detail",
        "pattern": "^(?P<item_no>\\d{3})\\*(?P<code>\\d{6,13})\\s+(?P<unit_price>[\\d,.]+)\\s+(?P<qty>\\d+)\\s+(?P<total_price>[\\d,.]+)$",
        "flags": [],
        "extract_fields": [
          "item_no",
          "code",
          "unit_price",
          "qty",
          "total_price"
        ],
        "description": "3자리 번호 + * + code + unit_price + qty + total_price"
      },
      {
        "name": "star_code_unit_total_missing_qty",
        "role": "item_detail",
        "pattern": "^\\*\\s*(?P<code>\\d{6,13})\\s+(?P<unit_price>[\\d,.]+)\\s+(?P<total_price>[\\d,.]+)$",
        "flags": [],
        "extract_fields": [
          "code",
          "unit_price",
          "total_price"
        ],
        "post_process": {
          "qty": 1,
          "is_imputed_qty": true
        },
        "description": "* + code + unit_price + total_price (qty 누락)"
      },
      {
        "name": "plain_code_unit_total_missing_qty",
        "role": "item_detail",
        "pattern": "^(?P<code>\\d{6,13})\\s+(?P<unit_price>[\\d,.]+)\\s+(?P<total_price>[\\d,.]+)$",
        "flags": [],
        "extract_fields": [
          "code",
          "unit_price",
          "total_price"
        ],
        "post_process": {
          "qty": 1,
          "is_imputed_qty": true
        },
        "description": "code + unit_price + total_price (qty 누락)"
      }
    ],
    "examples": [
      "*265405 17,690 1 17,690",
      "8801045447001 2,180 1 2,180",
      "* 8809636710008 7,890 1 7,890",
      "001*8801448212053 1,680 1 1,680",
      "002*2100051133899 2,000 2 4.000",
      "003*253211 12.900 1 12.900",
      "238886 10,100 1 10,100",
      "037600257640 9,480 1 9,480",
      "*230438 2,700 2,700"
    ],
    "notes": [
      "하나로 기본 상세라인은 code + unit_price + qty + total_price 순서",
      "code 길이는 6~13자리까지 허용",
      "qty 누락 시 3-token 구조를 qty=1로 보정 가능",
      "점(.) 구분자는 normalization 후 천 단위 콤마로 처리"
    ]
  },
  "field_mapping": {
    "item_name": {
      "name_raw": "name"
    },
    "item_detail": {
      "code": "code",
      "qty": "qty",
      "unit_price_raw": "unit_price",
      "price_raw": "total_price",
      "name_raw": "name"
    }
  },
  "normalization_hints": [
    {
      "name": "strip_leading_star_prefix",
      "description": "*265405 -> 265405 / * 8809636710008 -> 8809636710008"
    },
    {
      "name": "strip_item_number_prefix",
      "description": "001 P삼겹살 -> P삼겹살 / 001*880144... -> 880144..."
    },
    {
      "name": "remove_square_bracket_segments_from_name",
      "description": "[3,800], [카드쿠폰(율)] 같은 대괄호 정보 제거"
    },
    {
      "name": "remove_nonsemantic_english_prefix_from_name",
      "description": "COB 같은 영문 prefix 제거 가능"
    },
    {
      "name": "normalize_dot_separator_amount",
      "description": "4.000 -> 4,000 / 12.900 -> 12,900"
    },
    {
      "name": "impute_qty_as_1_for_3_token_detail",
      "description": "code + unit_price + total_price 구조면 qty=1 보정"
    }
  ],
  "classification_rules": [
    {
      "name": "detail_before_name",
      "if": "line matches any item_detail pattern",
      "assign_role": "item_detail",
      "description": "숫자 구조 상세라인 우선"
    },
    {
      "name": "numbered_text_name",
      "if": "line starts with 3-digit item number and does not match detail pattern",
      "assign_role": "item_name",
      "description": "번호 prefix 상품명"
    },
    {
      "name": "fallback_text_to_item_name",
      "if": "line does not match detail/discount/summary/noise patterns and looks like product text",
      "assign_role": "item_name",
      "description": "일반 텍스트 fallback"
    }
  ],
  "fallback_rules": [
    {
      "condition": "line starts with code-like token and has 3 or 4 transactional tokens",
      "assign_role": "item_detail"
    },
    {
      "condition": "line contains product-like text and does not match other pattern groups",
      "assign_role": "item_name"
    }
  ],
  "semantic_handoff_notes": [
    "item_name과 item_detail은 parser에서 연결하지 않는다",
    "상품명 정규화는 가능하지만 raw text는 반드시 보존한다",
    "discount 연결과 최종 item 생성은 semantic interpreter에서 수행한다"
  ],
  "forbidden_parser_behaviors": [
    {
      "name": "do_not_attach_discount",
      "reason": "할인 귀속은 semantic_interpreter 책임"
    },
    {
      "name": "do_not_merge_multi_line_item_object",
      "reason": "item_name + item_detail 결합은 semantic 단계에서 수행"
    }
  ]
}