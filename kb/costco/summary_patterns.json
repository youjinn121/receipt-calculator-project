{
  "version": "1.0.0",
  "description": "Costco summary, subtotal, total, and tail-section patterns",
  "line_roles_supported": [
    "subtotal",
    "total"
  ],
  "classification_priority": [
    "total",
    "subtotal"
  ],
  "subtotal_patterns": {
    "description": "중간 합계 또는 상품 수 관련 라인",
    "match_mode": "regex_or_contains",
    "patterns": [
      {
        "name": "item_count_subtotal",
        "role": "subtotal",
        "pattern": "^상품수\\s*소계\\s*[:：]?\\s*(?P<value>[\\d,]+)?$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "상품수 소계 라인"
      },
      {
        "name": "sub_total_item_count",
        "role": "subtotal",
        "pattern": "^\\(?Sub-총상품수\\s*[:：]?\\s*(?P<count>\\d+)?\\)?\\s*(?P<value>[\\d,]+)?$",
        "flags": [],
        "extract_fields": [
          "price_raw",
          "count_raw"
        ],
        "description": "Sub-총상품수 라인"
      },
      {
        "name": "sub_total_item_count_ocr_variant",
        "role": "subtotal",
        "pattern": "^\\(?Sub-총싱품수\\s*[:：]?\\s*(?P<count>\\d+)?\\)?\\s*(?P<value>[\\d,]+)?$",
        "flags": [],
        "extract_fields": [
          "price_raw",
          "count_raw"
        ],
        "description": "총상품수 OCR 오인식 변형"
      },
      {
        "name": "sub_total_item_short_variant",
        "role": "subtotal",
        "pattern": "^\\(?Sub-총상품\\s*[:：]?\\s*(?P<count>\\d+)?\\)?\\s*(?P<value>[\\d,]+)?$",
        "flags": [],
        "extract_fields": [
          "price_raw",
          "count_raw"
        ],
        "description": "총상품수에서 '수'가 누락된 변형"
      },
      {
        "name": "total_item_keyword_contains",
        "role": "subtotal",
        "pattern": "총상품수|총싱품수|총상품",
        "flags": [],
        "extract_fields": [],
        "description": "상품 수 관련 보조 키워드"
      }
    ],
    "examples": [
      "상품수 소계 : 10",
      "(Sub-총상품수 : 13) 144420",
      "(Sub-총싱품수 : 6) 80510",
      "(Sub-총상품 : 5)"
    ]
  },
  "total_patterns": {
    "description": "최종 결제 금액 라인",
    "match_mode": "regex_or_contains",
    "patterns": [
      {
        "name": "vat_included_total",
        "role": "total",
        "pattern": "^합계\\s*(\\(VAT\\s*포함\\))?\\s*(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "합계 (VAT 포함) 또는 합계 라인"
      },
      {
        "name": "simple_total_contains",
        "role": "total",
        "pattern": "합계",
        "flags": [],
        "extract_fields": [],
        "description": "합계 키워드 포함 보조 규칙"
      }
    ],
    "examples": [
      "합계 (VAT 포함) 232,330",
      "합계 232,330"
    ]
  },
  "tail_section_keywords": {
    "description": "이 키워드가 등장하면 item parsing 종료 구간으로 판단 가능",
    "keywords": [
      {
        "value": "상품수 소계",
        "type": "subtotal"
      },
      {
        "value": "총상품수",
        "type": "subtotal"
      },
      {
        "value": "총싱품수",
        "type": "subtotal"
      },
      {
        "value": "총상품",
        "type": "subtotal"
      },
      {
        "value": "면세",
        "type": "tail_summary"
      },
      {
        "value": "과세",
        "type": "tail_summary"
      },
      {
        "value": "부가세",
        "type": "tail_summary"
      },
      {
        "value": "합계",
        "type": "total"
      }
    ],
    "notes": [
      "tail section 키워드는 line_type을 직접 결정하기보다 종료 구간 판정에 사용 가능",
      "면세, 과세, 부가세는 total이 아니며 validation/tail summary 참고용이다"
    ]
  },
  "tax_summary_patterns": {
    "description": "세금/요약 관련 보조 패턴. 기본 line_type은 noise 또는 tail_summary 취급 가능하나 parser에서는 참고용으로 사용",
    "match_mode": "regex_or_contains",
    "patterns": [
      {
        "name": "tax_free_amount",
        "pattern": "^면세\\s+(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "면세 금액 라인"
      },
      {
        "name": "taxable_amount",
        "pattern": "^과세\\s+(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "과세 금액 라인"
      },
      {
        "name": "vat_amount",
        "pattern": "^부가세\\s+(?P<value>[\\d,]+)$",
        "flags": [],
        "extract_fields": [
          "price_raw"
        ],
        "description": "부가세 금액 라인"
      }
    ],
    "examples": [
      "면세 115,060",
      "과세 106,609",
      "부가세 10,661"
    ],
    "notes": [
      "이 라인들은 일반 item 파싱 대상이 아니며 검증 또는 tail-section 판정에 사용 가능",
      "최종 common line_type에 tax 전용 타입이 없으므로 별도 field로만 보존하거나 noise로 유지할 수 있다"
    ]
  },
  "field_mapping": {
    "subtotal": {
      "price_raw": "value",
      "count_raw": "count"
    },
    "total": {
      "price_raw": "value"
    },
    "tax_summary": {
      "price_raw": "value"
    }
  },
  "fallback_rules": [
    {
      "condition": "line contains 합계 and does not match item_detail or discount_detail",
      "assign_role": "total"
    },
    {
      "condition": "line contains 상품수 소계 or 총상품수 or 총상품 and does not match item_detail",
      "assign_role": "subtotal"
    }
  ],
  "parser_notes": [
    "total must be checked before generic noise classification",
    "subtotal and total lines are not item lines",
    "면세/과세/부가세 라인은 item parsing 종료 구간 판단에 사용할 수 있다",
    "tax_summary_patterns는 common line_type으로 직접 매핑되지 않을 수 있으므로 roles_map과 함께 처리해야 한다"
  ],
  "semantic_handoff_notes": [
    "subtotal and total lines are preserved for validation and receipt-level reconciliation",
    "parser extracts only numeric candidates and does not perform receipt-level validation"
  ]
}