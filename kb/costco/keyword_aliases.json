  "recommended_matching_order": [
    "normalize whitespace and special spacing",
    "apply alias matching",
    "apply store-specific pattern matching",
    "map store role to common line_type"
  ],
  "parser_notes": [
    "Alias matching should not overwrite the original line_text.",
    "IRC, EXM, PP tags should remain visible in raw text for semantic interpreter handoff.",
    "This file is for keyword equivalence and OCR variant matching only.",
    "Numeric parsing and discount detail extraction must be handled in item_patterns.json or discount_patterns.json."
  ]
