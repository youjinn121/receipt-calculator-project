{
  "version": "1.0.0",
  "description": "Costco item name and item detail parsing patterns",
  "line_roles_supported": [
    "item_name",
    "item_detail"
  ],
  "classification_priority": [
    "item_detail",
    "item_name"
  ],
  "item_name_patterns": {
    "description": "상품명 라인 판별 (숫자 패턴이 없는 텍스트 중심)",
    "match_mode": "fallback_text",
    "rules": [
      {
        "name": "text_only_line",
        "role": "item_name",
        "condition": "line does not match item_detail pattern and is not classified as other roles",
        "description": "숫자 패턴이 없는 일반 텍스트 라인"
      }
    ],
    "examples": [
      "카스375MLX20캔",
      "유기농 우유",
      "정통어묵탕모듬"
    ]
  },
  "item_detail_patterns": {
    "description": "상품 상세 라인 패턴 (code + qty + unit_price + total_price)",
    "match_mode": "regex",
    "patterns": [
      {
        "name": "code_qty_unit_total_standard",
        "role": "item_detail",
        "pattern": "^(?P<code>\\d{6,7})\\s+(?P<qty>\\d+[xX])\\s+(?P<unit_price>[\\d,.\\s]+)\\s+(?P<total_price>[\\d,.\\s]+)\\s*T?$",
        "flags": [],
        "extract_fields": [
          "code",
          "qty",
          "unit_price",
          "total_price"
        ],
        "description": "기본 구조: code + qty(x 포함) + unit_price + total_price"
      },
      {
        "name": "code_plain_qty_unit_total",
        "role": "item_detail",
        "pattern": "^(?P<code>\\d{6,7})\\s+(?P<qty>\\d+)\\s+(?P<unit_price>[\\d,.\\s]+)\\s+(?P<total_price>[\\d,.\\s]+)\\s*T?$",
        "flags": [],
        "extract_fields": [
          "code",
          "qty",
          "unit_price",
          "total_price"
        ],
        "description": "x 없는 수량 표기"
      },
      {
        "name": "code_unit_total_missing_qty",
        "role": "item_detail",
        "pattern": "^(?P<code>\\d{6,7})\\s+(?P<unit_price>[\\d,.\\s]+)\\s+(?P<total_price>[\\d,.\\s]+)\\s*T?$",
        "flags": [],
        "extract_fields": [
          "code",
          "unit_price",
          "total_price"
        ],
        "post_process": {
          "qty": 1,
          "is_imputed_qty": true
        },
        "description": "qty 누락 케이스 → qty=1 보정"
      },
      {
        "name": "code_short_length_support",
        "role": "item_detail",
        "pattern": "^(?P<code>\\d{4,7})\\s+(?P<qty>\\d+[xX]?)\\s+(?P<unit_price>[\\d,.\\s]+)\\s+(?P<total_price>[\\d,.\\s]+)\\s*T?$",
        "flags": [],
        "extract_fields": [
          "code",
          "qty",
          "unit_price",
          "total_price"
        ],
        "description": "4~7자리 코드 지원 (할인/특수 상품 포함)"
      }
    ],
    "examples": [
      "672904 1x 25,490 25,490",
      "650635 2x 9,590 19,180",
      "502305 1 2990 2,990T",
      "1100270 1 19490 19,490 T",
      "630218 7990 7,990 T"
    ]
  },
  "field_normalization_hints": [
    {
      "name": "normalize_qty",
      "description": "1X → 1x / '1 x' → '1x'"
    },
    {
      "name": "normalize_number_spacing",
      "description": "10, 790 → 10,790"
    },
    {
      "name": "normalize_dot_separator",
      "description": "2.500 → 2,500"
    },
    {
      "name": "strip_trailing_T",
      "description": "금액 뒤 T 제거"
    }
  ],
  "fallback_rules": [
    {
      "condition": "line matches numeric pattern with 2~4 tokens and starts with digit",
      "assign_role": "item_detail"
    },
    {
      "condition": "line contains no numeric structure and is not classified as noise/discount/summary",
      "assign_role": "item_name"
    }
  ],
  "edge_cases": [
    {
      "case": "qty missing",
      "example": "630218 7990 7,990 T",
      "handling": "qty=1 보정"
    },
    {
      "case": "uppercase qty marker",
      "example": "1X",
      "handling": "1x로 정규화"
    },
    {
      "case": "broken numeric spacing",
      "example": "10, 790",
      "handling": "10,790으로 정규화"
    },
    {
      "case": "dot separator",
      "example": "2.500",
      "handling": "2,500으로 정규화"
    }
  ],
  "semantic_handoff_notes": [
    "item_name과 item_detail은 parser에서 연결하지 않는다",
    "여러 줄로 구성된 상품은 semantic interpreter에서 병합한다",
    "discount 연결은 parser에서 수행하지 않는다"
  ]
}